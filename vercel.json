{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/skill", "destination": "/gradient-skin.skill" },
    { "source": "/skills", "destination": "/gradient-skin.skill" }
  ],
  "headers": [
    { "source": "/install", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/gradient-skin.skill", "headers": [{ "key": "Content-Type", "value": "application/zip" }, { "key": "Content-Disposition", "value": "attachment; filename=\"gradient-skin.skill\"" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(.*)\\.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
